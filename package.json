{
  "name": "@kisasa/shopify-mcp",
  "version": "1.2.0",
  "description": "MCP server for the Shopify Admin GraphQL API: products, media, orders, customers, inventory, and sales channels",
  "mcpName": "io.github.kisasa/shopify-mcp",
  "main": "dist/index.js",
  "bin": {
    "shopify-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "validate:graphql": "graphql-codegen --config .graphqlrc.ts",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.ts'",
    "clean": "rimraf dist"
  },
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "graphql",
    "ai",
    "llm",
    "claude",
    "mcp-server",
    "shopify-admin-api",
    "ecommerce"
  ],
  "author": "Kisasa",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "dotenv": "^16.0.3",
    "graphql": "^16.6.0",
    "graphql-request": "^5.1.0",
    "minimist": "^1.2.8",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/minimist": "^1.2.2",
    "@types/node": "^18.15.11",
    "@graphql-codegen/cli": "^6.2.1",
    "@shopify/admin-api-client": "^1.1.2",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisasa/shopify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kisasa/shopify-mcp/issues"
  },
  "homepage": "https://github.com/kisasa/shopify-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
